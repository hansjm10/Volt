{
	"name": "volt-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"packages/coding-agent/examples/extensions/with-deps",
		"packages/coding-agent/examples/extensions/custom-provider-anthropic",
		"packages/coding-agent/examples/extensions/custom-provider-gitlab-duo",
		"packages/coding-agent/examples/extensions/sandbox",
		"packages/coding-agent/examples/extensions/gondolin"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "cd packages/tui && npm run build && cd ../ai && npm run build && cd ../agent && npm run build && cd ../coding-agent && npm run build",
		"benchmark:streaming-markdown": "node --experimental-strip-types --conditions volt-source packages/coding-agent/benchmarks/streaming-markdown.ts",
		"benchmark:memory": "node scripts/benchmark-coding-agent-memory.mjs",
		"check": "biome check --write --error-on-warnings . && npm run check:pinned-deps && npm run check:changesets && npm run check:ts-imports && npm run check:coding-agent-source-exports && npm run check:shrinkwrap && npm run check:rpc-contract && npm run check:release-security && tsgo --noEmit && tsgo --noEmit -p packages/tui/tsconfig.json && tsgo --noEmit -p packages/agent/tsconfig.json && npm run check:browser-smoke",
		"check:browser-smoke": "node scripts/check-browser-smoke.mjs",
		"check:coding-agent-source-exports": "node scripts/check-coding-agent-source-exports.mjs",
		"check:pinned-deps": "node scripts/check-pinned-deps.mjs",
		"changelog:preview": "node scripts/changelog.mjs render",
		"changeset:add": "node scripts/changelog.mjs add",
		"changeset:draft": "node scripts/draft-changeset.mjs",
		"check:changesets": "node scripts/check-changesets.mjs",
		"check:release-security": "node --test scripts/release-security.test.mjs scripts/bootstrap-npm-packages.test.mjs scripts/changelog.test.mjs scripts/check-changesets.test.mjs scripts/draft-changeset.test.mjs scripts/edit-tool-stats.test.mjs",
		"check:rpc-contract": "node scripts/generate-rpc-schema.ts --check",
		"check:shrinkwrap": "node scripts/generate-coding-agent-shrinkwrap.mjs --check",
		"check:ts-imports": "node scripts/check-ts-relative-imports.mjs",
		"contract:rpc": "node scripts/generate-rpc-schema.ts",
		"iroh:poc:install": "npm install --ignore-scripts",
		"iroh:poc:host": "node --conditions volt-source scripts/iroh-sidecar-run.mjs host",
		"iroh:poc:host:volt": "node --conditions volt-source scripts/iroh-sidecar-run.mjs host --integrated-volt --workspace volt=.",
		"iroh:poc:client": "node --conditions volt-source scripts/iroh-sidecar-run.mjs client",
		"iroh:poc:clients": "node --conditions volt-source scripts/iroh-sidecar-run.mjs host clients",
		"iroh:poc:revoke": "node --conditions volt-source scripts/iroh-sidecar-run.mjs host revoke",
		"profile:tui": "node scripts/profile-coding-agent-node.mjs --mode tui",
		"profile:rpc": "node scripts/profile-coding-agent-node.mjs --mode rpc",
		"test:memory-benchmark": "node --test scripts/benchmark-coding-agent-memory.test.mjs",
		"test": "npm run test:memory-benchmark && npm run test --workspaces --if-present && npm --prefix packages/coding-agent/examples/remote/firebase-push-relay/functions test",
		"version:patch": "npm version patch -ws --no-git-tag-version && node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts",
		"version:minor": "npm version minor -ws --no-git-tag-version && node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts",
		"version:major": "npm version major -ws --no-git-tag-version && node scripts/sync-versions.js && npm install --package-lock-only --ignore-scripts",
		"version:set": "npm version -ws",
		"prepublishOnly": "npm run clean && npm run build && npm run check",
		"publish": "npm run prepublishOnly && node scripts/publish.mjs",
		"publish:dry": "npm run prepublishOnly && node scripts/publish.mjs --dry-run",
		"release:local": "node scripts/local-release.mjs",
		"shrinkwrap:coding-agent": "node scripts/generate-coding-agent-shrinkwrap.mjs",
		"release:initial": "node scripts/release.mjs prepare 0.1.0",
		"release:patch": "node scripts/release.mjs prepare patch",
		"release:minor": "node scripts/release.mjs prepare minor",
		"release:major": "node scripts/release.mjs prepare major",
		"release:finalize": "node scripts/release.mjs finalize",
		"release:prepare-pr": "node scripts/release.mjs prepare-pr",
		"release:authorize": "node scripts/release.mjs authorize",
		"release:fix-links": "node scripts/release-notes.mjs fix-github-releases",
		"prepare": "husky"
	},
	"devDependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.26",
		"@biomejs/biome": "2.3.5",
		"@changesets/cli": "2.31.0",
		"@types/node": "22.19.19",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"esbuild": "0.28.1",
		"husky": "9.1.7",
		"jiti": "2.7.0",
		"postject": "1.0.0-alpha.6",
		"shx": "0.4.0",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.1.0",
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	}
}
