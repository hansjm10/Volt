# Copy to the Firebase project's environment-specific .env file for a
# disposable canary project. Never use production Firestore or commit secrets.
ALLOWED_FIREBASE_APP_IDS=1:000000000000:ios:replace-with-canary-app-id
FUNCTION_REGION=us-central1
IROH_RELAY_ORIGINS=https://canary-iroh-relay.example.com
IROH_ENROLLMENT_REQUESTS_PER_ENDPOINT_PER_MINUTE=20
IROH_ENROLLMENT_REQUESTS_PER_IP_PER_MINUTE=60
PUSH_RELAY_URL=https://replace-with-canary-push-edge.example.com
PUSH_TARGET_TTL_DAYS=7
DELIVERIES_PER_TARGET_PER_MINUTE=10
REGISTRATIONS_PER_INSTANCE_PER_MINUTE=10

# IROH_ENROLLMENT_IP_SALT, IROH_RELAY_ACCESS_SECRET_CURRENT, and
# IROH_RELAY_ACCESS_SECRET_NEXT belong in Firebase Secret Manager only.
