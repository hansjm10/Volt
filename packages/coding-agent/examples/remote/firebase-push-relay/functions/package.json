{
	"name": "volt-firebase-push-relay-functions",
	"version": "0.0.0",
	"private": true,
	"type": "commonjs",
	"main": "index.js",
	"engines": {
		"node": "22"
	},
	"scripts": {
		"check": "for file in *.js; do node --check \"$file\"; done",
		"test": "node --test *.test.js",
		"test:emulator": "firebase emulators:exec --config ../firebase.json --project demo-volt-iroh-enrollment --only firestore \"node --test enrollment-emulator.integration.js\""
	},
	"dependencies": {
		"firebase-admin": "14.2.0",
		"firebase-functions": "7.3.2"
	},
	"devDependencies": {
		"firebase-tools": "15.26.0"
	}
}
