---
import BlogShell from "./BlogShell.astro";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    canonicalPath: string;
    updated: string;
  };
}

const { title, description, canonicalPath, updated } = Astro.props.frontmatter;
---

<BlogShell title={`${title} — Volt`} description={description} canonicalPath={canonicalPath}>
  <article class="post-shell">
    <header class="post-header">
      <p class="eyebrow">Volt / Volt-CLI</p>
      <h1>{title}</h1>
      <p class="post-description">Last updated: {updated}</p>
    </header>
    <div class="post-content">
      <slot />
    </div>
  </article>
</BlogShell>

<style>
  .post-content :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
