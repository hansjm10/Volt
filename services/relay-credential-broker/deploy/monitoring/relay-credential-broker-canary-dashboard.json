  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 48,
        "height": 5,
        "widget": {
          "title": "Canary scope and runbook",
          "text": {
            "format": "MARKDOWN",
            "content": "# Volt relay credential canary\n\nCloud Run service: `relay-credential-broker-canary` · Cloud SQL: `volt-relay-credentials-canary` · Region: `us-central1`\n\nHealthy enrollment: claim `201` → pending exchange `202` → app approval `200` → host exchange `200`. Investigate `429`, `5xx`, KMS errors, or sustained PostgreSQL saturation. Log-based metric data begins when the metric is created and is not backfilled."
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 5,
        "width": 24,
        "height": 16,
        "widget": {
          "title": "Pairing requests by operation and status",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "minAlignmentPeriod": "60s",
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/user/relay_credential_pairing_requests\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"relay-credential-broker-canary\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"operation\"",
                        "metric.label.\"status\""
                      ]
                    }
                  }
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "requests/s",
              "scale": "LINEAR"
            }
          }
        }
      },
