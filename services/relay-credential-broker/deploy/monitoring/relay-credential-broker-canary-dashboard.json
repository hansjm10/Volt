  "displayName": "Volt Relay Credential Broker — Canary",
  "description": "Canary enrollment, broker, KMS, and PostgreSQL health for the Volt managed relay credential flow.",
  "category": "CUSTOM",
  "dashboardFilters": [],
  "labels": {
    "canary": "",
    "relay-credentials": ""
