{
  "name": "relay_credential_pairing_requests",
  "description": "Counts relay credential broker pairing requests by HTTP status and operation without extracting claim or endpoint identifiers.",
  "filter": "resource.type=\"cloud_run_revision\"\nresource.labels.service_name=\"relay-credential-broker-canary\"\nlog_id(\"run.googleapis.com/requests\")\nhttpRequest.requestUrl:\"/v1/pairing-claims\"",
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "INT64",
    "unit": "1",
    "labels": [
      {
        "key": "status",
        "valueType": "INT64",
        "description": "HTTP response status."
      },
      {
        "key": "operation",
        "valueType": "STRING",
        "description": "approve or exchange; an empty value identifies claim creation."
      }
    ]
  },
  "labelExtractors": {
    "status": "EXTRACT(httpRequest.status)",
    "operation": "REGEXP_EXTRACT(httpRequest.requestUrl, \"/v1/pairing-claims(?:/[^/]+/(approve|exchange))?$\")"
  }
}
