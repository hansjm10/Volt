+    #[tokio::test(start_paused = true)]
+    async fn expiry_preempts_a_selected_blocked_write_and_releases_the_connection_slot() {
+        let endpoint_id = endpoint_key().public();
+        let mut jwt_config = config();
+        jwt_config.clock_skew_seconds = 0;
+        let (disconnected_send, disconnected_recv) = oneshot::channel();
+        let access = Arc::new(TrackingAccess {
+            inner: JwtAccess::new(jwt_config).unwrap(),
+            disconnected: Mutex::new(Some(disconnected_send)),
+        });
+        let now = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_secs() as i64;
+        let jwt = token(endpoint_id, json!({"iat": now, "exp": now + 2}));
+        let first = request(endpoint_id, &jwt);
+        let first_connection_id = first.connection_id();
+        assert_eq!(access.on_connect(&first).await, Access::Allow);
+        let deadline = access
+            .connection_deadline(endpoint_id, first_connection_id)
+            .unwrap();
+        let guard = OnDisconnectGuard::for_access_control(access.clone(), &first);
+
+        let clients = Clients::default();
+        let metrics = Arc::new(Metrics::default());
+        let blocked_flushes = Arc::new(AtomicUsize::new(0));
+        let normal_flushes = Arc::new(AtomicUsize::new(0));
+        let (write_selected_send, write_selected_recv) = oneshot::channel();
+        let (stream_dropped_send, stream_dropped_recv) = oneshot::channel();
+        let blocked_stream = ControlledSink {
+            block_writes: true,
+            write_selected: Some(write_selected_send),
+            dropped: Some(stream_dropped_send),
+            flushes: blocked_flushes.clone(),
+        };
+        let mut blocked_config = ClientConfig::new(
+            guard,
+            RelayedStream::new(blocked_stream, KeyCache::new(0)),
+            ProtocolVersion::default(),
+        );
+        blocked_config.write_timeout = Duration::from_secs(60);
+        clients.register(blocked_config, metrics.clone());
+
+        // Replacing the active connection queues a status frame for the expiring actor.
+        // Its sink reports when that work has been selected, then holds the write pending.
+        let normal_stream = ControlledSink {
+            block_writes: false,
+            write_selected: None,
+            dropped: None,
+            flushes: normal_flushes.clone(),
+        };
+        let normal_config = ClientConfig::new(
+            OnDisconnectGuard::empty(endpoint_id),
+            RelayedStream::new(normal_stream, KeyCache::new(0)),
+            ProtocolVersion::default(),
+        );
+        clients.register(normal_config, metrics);
+        let write_selected_at =
+            tokio::time::timeout(Duration::from_millis(50), write_selected_recv)
+                .await
+                .expect("actor did not select the queued write before expiry")
+                .expect("blocked sink dropped before selecting the queued write");
+        assert!(write_selected_at < deadline);
+
+        let competing = request(endpoint_id, &jwt);
+        assert_eq!(
+            access.on_connect(&competing).await,
+            Access::Deny { reason: None },
+            "the first connection must hold its per-node slot before expiry"
+        );
+
+        tokio::time::sleep_until(deadline).await;
+        let close_bound = deadline + Duration::from_millis(10);
+        let (disconnected_at, stream_dropped_at) = tokio::time::timeout_at(close_bound, async {
+            let disconnected_at = disconnected_recv
+                .await
+                .expect("disconnect guard dropped without reporting release");
+            let stream_dropped_at = stream_dropped_recv
+                .await
+                .expect("blocked relay stream did not report closure");
+            (disconnected_at, stream_dropped_at)
+        })
+        .await
+        .expect("blocked actor remained alive past the authorization deadline");
+        assert!(disconnected_at <= close_bound);
+        assert!(stream_dropped_at <= close_bound);
+        assert_eq!(
+            blocked_flushes.load(Ordering::SeqCst),
+            0,
+            "expiry must drop the blocked stream without flushing"
+        );
+        assert!(
+            !clients.disconnect(endpoint_id, Some(first_connection_id)),
+            "expired actor remained registered after its stream was dropped"
+        );
+
+        let recovered = request(endpoint_id, &jwt);
+        assert_eq!(
+            access.on_connect(&recovered).await,
+            Access::Allow,
+            "expiry did not release the per-node connection slot"
+        );
+        access.on_disconnect(endpoint_id, recovered.connection_id());
+
+        clients.shutdown().await;
+        assert!(
+            normal_flushes.load(Ordering::SeqCst) > 0,
+            "ordinary clean shutdown must still flush its stream"
+        );
+    }
