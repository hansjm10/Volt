+            "aud": AUDIENCE,
+            "sub": endpoint_id.to_string(),
+            "exp": now + 900,
+            "iat": now,
+            "jti": "jwt_identifier_one",
+            "scope": "relay:connect",
+            "endpoint_kind": "host",
+            "grant_id": "grant_identifier_one"
+        });
+        let claims_object = claims.as_object_mut().unwrap();
+        for (key, value) in overrides.as_object().unwrap() {
+            claims_object.insert(key.clone(), value.clone());
+        }
+        let encoded_header = BASE64URL_NOPAD.encode(&serde_json::to_vec(&header).unwrap());
+        let encoded_claims = BASE64URL_NOPAD.encode(&serde_json::to_vec(&claims).unwrap());
+        let signing_input = format!("{encoded_header}.{encoded_claims}");
+        let signature = signing_key.sign(signing_input.as_bytes());
+        format!(
+            "{signing_input}.{}",
+            BASE64URL_NOPAD.encode(&signature.to_bytes())
+        )
+    }
+
+    fn request(endpoint_id: EndpointId, token: &str) -> ClientRequest {
+        let request = Request::builder()
+            .uri("/relay")
+            .header(AUTHORIZATION, format!("Bearer {token}"))
+            .body(())
+            .unwrap();
+        let (parts, _) = request.into_parts();
+        ClientRequest::new(endpoint_id, ProtocolVersion::default(), parts)
+    }
+
+    #[derive(Debug)]
+    struct TrackingAccess {
+        inner: JwtAccess,
+        disconnected: Mutex<Option<oneshot::Sender<Instant>>>,
+    }
+
+    impl AccessControl for TrackingAccess {
+        async fn on_connect(&self, request: &ClientRequest) -> Access {
+            self.inner.on_connect(request).await
+        }
+
+        fn connection_deadline(
+            &self,
+            endpoint_id: EndpointId,
+            connection_id: ConnectionId,
+        ) -> Option<Instant> {
+            self.inner.connection_deadline(endpoint_id, connection_id)
+        }
+
+        fn on_disconnect(&self, endpoint_id: EndpointId, connection_id: ConnectionId) {
+            self.inner.on_disconnect(endpoint_id, connection_id);
+            if let Some(disconnected) = self.disconnected.lock().unwrap().take() {
+                let _ = disconnected.send(Instant::now());
+            }
+        }
+    }
+
+    struct ControlledSink {
+        block_writes: bool,
+        write_selected: Option<oneshot::Sender<Instant>>,
+        dropped: Option<oneshot::Sender<Instant>>,
+        flushes: Arc<AtomicUsize>,
+    }
+
+    impl Drop for ControlledSink {
+        fn drop(&mut self) {
+            if let Some(dropped) = self.dropped.take() {
+                let _ = dropped.send(Instant::now());
+            }
+        }
+    }
+
+    impl Stream for ControlledSink {
+        type Item = Result<Bytes, StreamError>;
+
+        fn poll_next(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<Option<Self::Item>> {
+            Poll::Pending
+        }
+    }
+
+    impl Sink<Bytes> for ControlledSink {
+        type Error = StreamError;
+
+        fn poll_ready(
+            mut self: Pin<&mut Self>,
+            _cx: &mut Context<'_>,
+        ) -> Poll<Result<(), Self::Error>> {
+            if self.block_writes {
+                if let Some(write_selected) = self.write_selected.take() {
+                    let _ = write_selected.send(Instant::now());
+                }
+                Poll::Pending
+            } else {
+                Poll::Ready(Ok(()))
+            }
+        }
+
+        fn start_send(self: Pin<&mut Self>, _item: Bytes) -> Result<(), Self::Error> {
+            Ok(())
+        }
+
+        fn poll_flush(
+            self: Pin<&mut Self>,
+            _cx: &mut Context<'_>,
+        ) -> Poll<Result<(), Self::Error>> {
+            self.flushes.fetch_add(1, Ordering::SeqCst);
+            Poll::Ready(Ok(()))
+        }
+
+        fn poll_close(
+            self: Pin<&mut Self>,
+            _cx: &mut Context<'_>,
+        ) -> Poll<Result<(), Self::Error>> {
+            Poll::Ready(Ok(()))
+        }
+    }
+
+    async fn connect_expiring_client(clock_skew_seconds: u64) -> (Server, Client, Instant) {
+        let secret_key = endpoint_key();
+        let endpoint_id = secret_key.public();
+        let mut jwt_config = config();
+        jwt_config.clock_skew_seconds = clock_skew_seconds;
+        let access = Arc::new(JwtAccess::new(jwt_config).unwrap());
+
+        let mut relay = RelayConfig::new((Ipv4Addr::LOCALHOST, 0));
+        relay.key_cache_capacity = Some(1024);
+        relay.access = access.clone();
+        let mut server_config = ServerConfig::default();
+        server_config.relay = Some(relay);
+        let server = Server::spawn(server_config).await.unwrap();
+        let relay_url: RelayUrl = format!("http://{}", server.http_addr().unwrap())
+            .parse()
+            .unwrap();
+        let client_config = CaTlsConfig::default()
+            .client_config(default_provider())
+            .unwrap();
+        let now = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_secs() as i64;
+        let jwt = token(endpoint_id, json!({"iat": now, "exp": now + 2}));
+        let client = ClientBuilder::new(relay_url, secret_key, DnsResolver::new())
+            .tls_client_config(client_config)
+            .auth_token(jwt)
+            .connect()
+            .await
+            .unwrap();
+        let deadline = access
+            .state
+            .lock()
+            .unwrap()
+            .connections
+            .values()
+            .next()
+            .expect("connected client must have an authorization deadline")
+            .deadline;
+
+        (server, client, deadline)
+    }
