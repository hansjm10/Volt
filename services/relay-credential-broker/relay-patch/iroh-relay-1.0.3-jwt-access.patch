+    #[tokio::test]
+    async fn sustained_ping_traffic_stops_at_jwt_expiry() {
+        const POST_DEADLINE_PING: [u8; 8] = [u8::MAX; 8];
+
+        let (server, client, deadline) = connect_expiring_client(0).await;
+        let (mut incoming, mut outgoing) = client.split();
+        let traffic = tokio::spawn(async move {
+            let mut sequence = 0u64;
+            loop {
+                let after_deadline = Instant::now() >= deadline;
+                sequence = sequence.wrapping_add(1);
+                let data = if after_deadline {
+                    POST_DEADLINE_PING
+                } else {
+                    sequence.to_be_bytes()
+                };
+                let failed = outgoing.send(ClientToRelayMsg::Ping(data)).await.is_err();
+                if failed && after_deadline {
+                    break (sequence, Instant::now());
+                }
+                if failed {
+                    tokio::time::sleep_until(deadline).await;
+                } else {
+                    tokio::task::yield_now().await;
+                }
+            }
+        });
+
+        let pong_count = tokio::time::timeout_at(deadline + Duration::from_secs(1), async {
+            let mut pong_count = 0usize;
+            loop {
+                match incoming.next().await {
+                    Some(Ok(RelayToClientMsg::Pong(data))) => {
+                        assert_ne!(
+                            data, POST_DEADLINE_PING,
+                            "relay emitted a pong for a post-deadline ping"
+                        );
+                        pong_count += 1;
+                    }
+                    Some(Ok(_)) => continue,
+                    Some(Err(_)) | None => break,
+                }
+            }
+            pong_count
+        })
+        .await
+        .expect("sustained traffic kept the client open past the bounded expiry window");
+        let (sent_count, traffic_stopped_at) =
+            tokio::time::timeout(Duration::from_secs(1), traffic)
+                .await
+                .expect("traffic sender did not stop after relay closure")
+                .expect("traffic sender task failed");
+
+        assert!(pong_count > 1, "test did not sustain ping traffic");
+        assert!(sent_count > pong_count as u64);
+        assert!(
+            traffic_stopped_at >= deadline,
+            "test traffic stopped before the authorization deadline"
+        );
+        server.shutdown().await.unwrap();
+    }
