+
+const MAX_JWT_BYTES: usize = 8 * 1024;
+const MAX_VERIFICATION_KEYS: usize = 8;
+const MAX_AUTHORITY_BYTES: usize = 512;
+const MAX_IDENTIFIER_BYTES: usize = 128;
+const MIN_IDENTIFIER_BYTES: usize = 16;
+const HARD_MAX_TOKEN_LIFETIME_SECONDS: u64 = 60 * 60;
+const HARD_MAX_CLOCK_SKEW_SECONDS: u64 = 5 * 60;
+const HARD_MAX_GLOBAL_CONNECTIONS: usize = 100_000;
+const HARD_MAX_NODE_CONNECTIONS: usize = 64;
+const HARD_MAX_GRANT_CONNECTIONS: usize = 128;
+const HARD_MAX_CONCURRENT_VERIFICATIONS: usize = 256;
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct JwtAccessConfig {
+    /// Active and retiring Ed25519 public keys accepted by `kid` during rotation.
+    pub(crate) keys: Vec<JwtVerificationKey>,
+    /// Exact JWT issuer.
+    pub(crate) issuer: String,
+    /// Exact JWT audience.
+    pub(crate) audience: String,
+    /// Maximum accepted `exp - iat`, independently capped at one hour.
+    #[serde(default = "default_max_token_lifetime_seconds")]
+    pub(crate) max_token_lifetime_seconds: u64,
+    /// Clock skew accepted for `iat` and `exp`, capped at five minutes.
+    #[serde(default = "default_clock_skew_seconds")]
+    pub(crate) clock_skew_seconds: u64,
+    /// Maximum concurrent admitted relay connections.
+    #[serde(default = "default_max_global_connections")]
+    pub(crate) max_global_connections: usize,
+    /// Maximum concurrent connections for one proven Iroh endpoint ID.
+    #[serde(default = "default_max_node_connections")]
+    pub(crate) max_node_connections: usize,
+    /// Maximum concurrent connections sharing one anonymous pairing grant.
+    #[serde(default = "default_max_grant_connections")]
+    pub(crate) max_grant_connections: usize,
+    /// Maximum simultaneous JWT signature verifications.
+    #[serde(default = "default_max_concurrent_verifications")]
+    pub(crate) max_concurrent_verifications: usize,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct JwtVerificationKey {
+    /// Ed25519 public key as unpadded base64url (the JWKS `x` value). The `kid`
+    /// is derived as base64url(SHA-256(public_key)[0..12]), matching the broker.
+    pub(crate) public_key: String,
+}
+
+const fn default_max_token_lifetime_seconds() -> u64 {
+    HARD_MAX_TOKEN_LIFETIME_SECONDS
+}
+
+const fn default_clock_skew_seconds() -> u64 {
+    30
+}
+
+const fn default_max_global_connections() -> usize {
+    4096
+}
+
+const fn default_max_node_connections() -> usize {
+    8
+}
+
+const fn default_max_grant_connections() -> usize {
+    32
+}
+
+const fn default_max_concurrent_verifications() -> usize {
+    32
+}
